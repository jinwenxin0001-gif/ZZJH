# Docker Mailserver 15.1 laboratory profile.
# Keep this file limited to plain VAR=VALUE entries.
LOG_LEVEL=info
SUPERVISOR_LOGLEVEL=warn
DMS_DEBUG=0
ONE_DIR=1
ACCOUNT_PROVISIONER=FILE
ENABLE_UPDATE_CHECK=0
ENABLE_CLAMAV=0
ENABLE_RSPAMD=0
ENABLE_AMAVIS=0
ENABLE_FAIL2BAN=0
ENABLE_MANAGESIEVE=0
ENABLE_POP3=1
POSTFIX_INET_PROTOCOLS=ipv4
DOVECOT_INET_PROTOCOLS=ipv4
SPOOF_PROTECTION=1
POSTMASTER_ADDRESS=postmaster@zzjh.test
